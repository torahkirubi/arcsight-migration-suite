# ==============================================================================
# ArcSight Rule Migration Suite - Environment Configuration Template
# Copy to .env and fill in your values. Never commit .env to git.
# ==============================================================================

# LLM Providers
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Security & Vault
VAULT_MASTER_KEY=your_vault_master_key_here
JWT_SECRET_KEY=arcsight-migration-suite-secret-key-super-secure
VAULT_DB_PATH=/app/backend/data/vault.db

# Microsoft Sentinel / Log Analytics Query Service Principal
SENTINEL_WORKSPACE_ID=your_sentinel_workspace_id_here
AZURE_WORKSPACE_ID=your_sentinel_workspace_id_here
AZURE_TENANT_ID=your_azure_tenant_id_here
AZURE_CLIENT_ID=your_azure_client_id_here
AZURE_CLIENT_SECRET=your_azure_client_secret_here

# Azure Monitor Logs Ingestion (DCE / DCR) Service Principal
AZURE_LOG_INGEST_CLIENT_ID=your_log_ingest_client_id_here
AZURE_LOG_INGEST_SECRET=your_log_ingest_secret_here
DCE_INGESTION_ENDPOINT=https://<your-dce-name>.<region>.ingest.monitor.azure.com
DCR_IMMUTABLE_ID=dcr-<your-dcr-immutable-id>
CUSTOM_STREAM_NAME=Custom-SecurityEvents_CL
